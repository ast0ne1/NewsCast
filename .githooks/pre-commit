#!/bin/sh
# NewsCast must never record the work / stone-vml identity.
ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null) $(git var GIT_COMMITTER_IDENT 2>/dev/null)"
case "$ident" in
  *vml.com*|*stone-vml*|*"adam.stone@"*)
    echo "NewsCast commits must use Adam Stone <astone.aus@me.com>."
    echo "Refusing VML / stone-vml author or committer."
    exit 1
    ;;
esac
author_email="$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\([^>]*\)>.*/\1/p')"
if [ "$author_email" != "astone.aus@me.com" ]; then
  echo "NewsCast author must be astone.aus@me.com (got $author_email)."
  exit 1
fi
exit 0
