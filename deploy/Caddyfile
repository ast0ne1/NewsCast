# Example Caddy reverse proxy for NewsCast with opt-in LAN HTTPS.
#
# 1. Install Caddy on the Pi.
# 2. Set NewsCast HOST=127.0.0.1 (so LAN clients cannot bypass TLS).
# 3. Enable Settings → General → Require HTTPS.
# 4. Trust Caddy's local CA on phones/PCs the first time you connect.

{
	# Optional: email for ACME if you later use a public domain.
}

newscast.local {
	tls internal
	encode gzip
	reverse_proxy 127.0.0.1:8080
}

# HTTP → HTTPS redirect for the same hostname
http://newscast.local {
	redir https://{host}{uri} permanent
}
